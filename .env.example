# Supabase Configuration
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend Supabase Service Role (for server-side operations)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend
NODE_ENV=development
PORT=3001
VITE_API_URL=http://localhost:3001

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=your-midtrans-snap-url
VITE_MIDTRANS_CLIENT_KEY=your-midtrans-client-key

# SendGrid Email Configuration (for testing, use a test API key)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your Company

# Frontend
FRONTEND_URL=http://localhost:5173

# Sentry Error Tracking (optional)
# Get your DSN from: https://sentry.io/settings/<org>/projects/<project>/keys
SENTRY_DSN=